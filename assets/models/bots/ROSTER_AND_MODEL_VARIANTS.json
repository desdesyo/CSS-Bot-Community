  "asset_requirements": {
    "per_character": "unique model variant or a shared rig with unique bodygroup/skin + equipment combination; unique name/icon; team-safe silhouette",
    "source": "SMD/DMX + QC; compile MDL using Source SDK studiomdl",
    "runtime": "models/cssbc/bots/<team>/<model>.mdl",
    "materials": "materials/models/cssbc/bots/... VTF/VMT; shared atlases where possible",
    "validation": [
      "all models compile",
      "no missing materials",
      "consistent origin/feet and collision bounds",
      "animation sequence names match bot animation controller",
      "LOD or low-poly distant variant",
      "T/CT recognisable at 20-30m",
      "no hitbox advantage from cosmetic variation"
    ]
  },
  "weapons": {
    "principle": "upgrade models and materials without changing weapon balance or attachment compatibility",
    "common": [
      "clean high-poly source -> game-ready low-poly mesh",
      "baked normal/AO into texture where supported",
      "shared 512/1024 atlases",
      "metal roughness represented in albedo/spec workflow",
      "muzzle, magazine, stock and hand alignment checked"
    ],
    "qa": [
      "viewmodel and worldmodel alignment",
      "weapon attachment points",
      "reload/fire/inspect animations",
      "silhouette and team lighting readability",
      "VTF mipmaps and no texture shimmer",
      "polygon budget and draw calls"
    ]
  }
}