{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local CSS Bridge task",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "taskId", "operation", "gameRoot"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "taskId": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[A-Za-z0-9._-]+$" },
    "operation": { "const": "scan" },
    "gameRoot": { "type": "string", "minLength": 3, "maxLength": 512 },
    "maxFiles": { "type": "integer", "minimum": 1, "maximum": 100000, "default": 50000 },
    "maxFileBytesForHash": { "type": "integer", "minimum": 0, "maximum": 1073741824, "default": 536870912 }
  }
}
