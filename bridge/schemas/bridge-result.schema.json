{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local CSS Bridge result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "taskId", "status", "startedUtc", "completedUtc", "root", "summary", "files", "errors"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "taskId": { "type": "string" },
    "status": { "enum": ["reported", "partial", "failed"] },
    "startedUtc": { "type": "string", "format": "date-time" },
    "completedUtc": { "type": "string", "format": "date-time" },
    "root": { "type": "string" },
    "summary": { "type": "object" },
    "files": { "type": "array", "items": { "$ref": "file-record.schema.json" } },
    "errors": { "type": "array", "items": { "type": "string", "maxLength": 1000 } }
  }
}
